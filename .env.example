# ==============================================================================
# HIVEFLOW PLATFORM — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and configure your local or cloud endpoints.
# ==============================================================================

# Application Environment (local, staging, production)
APP_ENV=local
LOG_LEVEL=INFO
TIMEZONE=Asia/Karachi

# ==============================================================================
# METADATA REPOSITORY DATABASE (PostgreSQL)
# Used by SchemaCertifier, Job Registry, CDC Watermarks, and RBAC
# ==============================================================================
DB_HOST=postgres
DB_PORT=5432
DB_NAME=hiveflow_metadata
DB_USER=hiveflow_admin
DB_PASSWORD=change_this_to_a_secure_password
METADATA_DB_PASSWORD=change_this_to_a_secure_password

# ==============================================================================
# SPARK CONNECT & CLUSTER CONFIGURATION
# ==============================================================================
SPARK_CONNECT_URL=sc://spark-master:15002
SPARK_UI_URL=http://localhost:4040

# ==============================================================================
# FASTAPI CONTROL PLANE & SECURITY
# ==============================================================================
API_HOST=0.0.0.0
API_PORT=8000
SECRET_KEY=change_this_to_a_random_32_byte_hex_string_for_production
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ==============================================================================
# SAMPLE SOURCE DATABASES (Optional for demo/testing)
# ==============================================================================
# MySQL Source System
MYSQL_SOURCE_HOST=mysql-source
MYSQL_SOURCE_PORT=3306
MYSQL_SOURCE_USER=demo_user
MYSQL_SOURCE_PASSWORD=demo_password
MYSQL_SOURCE_DB=sample_crm

# Target Data Warehouse (PostgreSQL Target)
TARGET_DB_HOST=postgres
TARGET_DB_PORT=5432
TARGET_DB_NAME=hiveflow_dw
TARGET_DB_USER=hiveflow_admin
TARGET_DB_PASSWORD=change_this_to_a_secure_password
